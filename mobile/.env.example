# Copy to .env and fill in. EXPO_PUBLIC_* values are public by design (they ship inside the app).
# PostHog: Project settings -> Project API key (phc_...). Host: https://eu.i.posthog.com or https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# RevenueCat (later): public SDK keys per platform
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
